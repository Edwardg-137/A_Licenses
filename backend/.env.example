# Copiar a .env y ajustar valores. NUNCA commitear el .env real.

# PostgreSQL local (sin Docker). Crear la base con: CREATE DATABASE permisogt;
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/permisogt?schema=public"

# JWT
JWT_ACCESS_SECRET="cambiar-por-secreto-largo-aleatorio"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cambiar-por-otro-secreto-largo-aleatorio"
JWT_REFRESH_EXPIRES_IN_DAYS="7"

# App
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Almacenamiento de archivos en desarrollo (disco local, decisión D-007)
UPLOADS_DIR="./uploads"

# URL pública del frontend (embebida en el QR de la licencia)
PUBLIC_APP_URL="http://localhost:3000"

# Tenant por defecto del MVP (slug sembrado por el seed)
DEFAULT_TENANT_SLUG="guatemala"

# Seed: contraseña del Admin municipal de prueba (correo fijo: admin@permisogt.local)
SEED_ADMIN_PASSWORD="Admin123!"

# Validación inteligente (D-017). Opcionales: sin clave se usa heurística / se omite la visión.
GOOGLE_MAPS_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
