# Copiar a `.env` en la raíz si quieres personalizar Docker Compose.
# Este archivo SÍ puede versionarse; el `.env` real no.

# PostgreSQL (servicio db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=permisogt
# Puerto en el HOST (el contenedor usa 5432 internamente)
POSTGRES_PORT=5433

# API
BACKEND_PORT=3001
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=dev-jwt-access-secret-change-me
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
DEFAULT_TENANT_SLUG=guatemala
SEED_ADMIN_PASSWORD=Admin123!
# Ejecutar seed al arrancar el backend (true/false)
RUN_SEED=true

# Portal
FRONTEND_PORT=3000
# URL que usa el NAVEGADOR para llamar a la API (puerto publicado en el host)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Validación inteligente (D-017). Opcionales.
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
